---
interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Mokoszo</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <!-- x-cloak zapobiega flashowi niezainicjalizowanych szablonów Alpine -->
    <style>[x-cloak]{display:none!important}</style>
  </head>
  <body class="min-h-screen bg-white text-gray-900">
    <script>
      import Alpine from 'alpinejs';
      window.Alpine = Alpine;
      Alpine.start();
    </script>
    <header class="border-b border-gray-200 px-4">
      <nav class="mx-auto flex max-w-5xl items-stretch gap-6">
        <a href={base} class="inline-flex min-h-[44px] items-center text-lg font-bold text-green-700 hover:text-green-900">
          🥗 Mokoszo
        </a>
        <a href={`${base}plan/`} class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center text-sm text-gray-600 hover:text-gray-900">Plan</a>
        <a href={`${base}lista-zakupow/`} class="inline-flex min-h-[44px] items-center text-sm text-gray-600 hover:text-gray-900">
          Lista zakupów
        </a>
      </nav>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
  </body>
</html>
