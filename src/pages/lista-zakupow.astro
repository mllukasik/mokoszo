---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getIngredients } from '../lib/domain/getIngredients';
import { CATEGORY_ORDER } from '../lib/domain/shoppingList';
import ShoppingList from '../components/ShoppingList.astro';
import MacrosSummary from '../components/MacrosSummary.astro';

const allRecipes = await getCollection('recipes');
const ingredients = getIngredients();

const base = import.meta.env.BASE_URL;

// Mapa przepisów dla Alpine: id → {title, ingredients[]}
const recipesMap = Object.fromEntries(
  allRecipes.map((r) => [
    r.id.replace(/\.md$/, ''),
    {
      title: r.data.title,
      ingredients: r.data.ingredients, // [{ingredientId, quantity}]
    },
  ])
);

// Mapa składników dla Alpine: id → dane potrzebne do obliczeń i wyświetlenia
const ingredientsMap = Object.fromEntries(
  ingredients.map((ing) => [
    ing.id,
    {
      displayName: ing.displayName,
      unitSymbol: ing.unit.symbol,
      category: ing.category,
      decimalPlaces: ing.formatting.decimalPlaces,
      nutritionPerUnit: ing.nutritionPerUnit,
      alternativeUnit: ing.alternativeUnit ?? null,
    },
  ])
);

const categoryLabels: Record<string, string> = {
  warzywa: 'Warzywa 🥦',
  owoce: 'Owoce 🍌',
  mięso: 'Mięso i ryby 🥩',
  nabiał: 'Nabiał 🥛',
  zboża: 'Zboża i makarony 🌾',
  konserwy: 'Konserwy 🥫',
  oleje: 'Oleje i tłuszcze 🫙',
  przyprawy: 'Przyprawy 🧂',
};
---

<Base title="Lista zakupów">
  <div x-data="shoppingListPage()">

    <!-- Stan pusty: brak zaplanowanych dni w zakresie lub żaden przepis -->
    <div x-show="isEmpty" style="display:none" class="flex flex-col items-center justify-center py-20 text-center">
      <p class="mb-2 text-5xl">🛒</p>
      <p class="mb-1 text-xl font-semibold text-gray-800">Lista jest pusta</p>
      <p class="mb-6 text-sm text-gray-500" x-text="allDays.length === 0
        ? 'Najpierw ułóż plan jadłospisu, żeby wygenerować listę zakupów.'
        : 'Brak przepisów w wybranym zakresie dat.'">
      </p>
      <a
        href={`${base}plan/`}
        class="inline-flex items-center gap-2 rounded-xl bg-green-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-green-700"
      >
        → Przejdź do planera
      </a>
    </div>

    <!-- Zawartość -->
    <div x-show="!isEmpty || allDays.length > 0" style="display:none">

      <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-3xl font-bold text-gray-900">Lista zakupów</h1>
        <a
          href={`${base}plan/`}
          class="inline-flex min-h-[44px] items-center text-sm text-gray-500 hover:text-gray-700"
        >
          ← Wróć do planera
        </a>
      </div>

      <!-- Zakres dat -->
      <div class="mb-6 flex flex-wrap items-end gap-3 rounded-xl border border-gray-200 bg-gray-50 p-4">
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500" for="date-from">Od</label>
          <input
            id="date-from"
            type="date"
            x-model="dateFrom"
            @change="_rebuild()"
            class="rounded-lg border border-gray-300 px-3 py-2 text-base focus:border-green-500 focus:outline-none"
          />
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500" for="date-to">Do</label>
          <input
            id="date-to"
            type="date"
            x-model="dateTo"
            @change="_rebuild()"
            :min="dateFrom"
            class="rounded-lg border border-gray-300 px-3 py-2 text-base focus:border-green-500 focus:outline-none"
          />
        </div>
        <p class="text-sm text-gray-500" x-text="rangeLabel"></p>
      </div>

      <!-- Makra -->
      <MacrosSummary />

      <!-- Lista zakupów z checkboxami -->
      <ShoppingList />
    </div>

  </div>
</Base>

<script is:inline define:vars={{ recipesMap, ingredientsMap, CATEGORY_ORDER, categoryLabels }}>
  const DAYS_KEY  = 'mokoszo:days:v3';
  const PLANS_KEY = 'mokoszo:plans:v2'; // legacy — only for migration

  /** Wczytuje dni z v3, migruje z v2 jeśli potrzeba. */
  function loadDays() {
    try {
      const raw = localStorage.getItem(DAYS_KEY);
      if (raw) {
        const p = JSON.parse(raw);
        if (p.version === 3 && Array.isArray(p.days)) return p.days;
      }
    } catch {}

    // Migracja z v2
    try {
      const raw = localStorage.getItem(PLANS_KEY);
      if (raw) {
        const p = JSON.parse(raw);
        if (p.version === 2 && Array.isArray(p.plans)) {
          const byDate = new Map();
          for (const plan of p.plans) {
            for (const day of (plan.days ?? [])) {
              if (!byDate.has(day.date)) byDate.set(day.date, day);
            }
          }
          const days = [...byDate.values()].sort((a, b) => a.date.localeCompare(b.date));
          try { localStorage.setItem(DAYS_KEY, JSON.stringify({ version: 3, days })); } catch {}
          return days;
        }
      }
    } catch {}

    return [];
  }

  function todayISO() {
    return new Date().toISOString().split('T')[0];
  }

  function addDaysISO(iso, n) {
    const d = new Date(iso + 'T12:00:00');
    d.setDate(d.getDate() + n);
    return d.toISOString().split('T')[0];
  }

  function fmtShort(iso) {
    return new Intl.DateTimeFormat('pl-PL', { day: 'numeric', month: 'short' })
      .format(new Date(iso + 'T12:00:00'));
  }

  /**
   * Agreguje składniki z podanych recipeIds.
   * Wynik: { [category]: [{ingredientId, displayName, quantity, unit, altDisplay}] }
   */
  function buildList(recipeIds) {
    const totals = {};
    for (const rid of recipeIds) {
      const recipe = recipesMap[rid];
      if (!recipe) continue;
      for (const { ingredientId, quantity } of recipe.ingredients) {
        totals[ingredientId] = (totals[ingredientId] ?? 0) + parseFloat(quantity);
      }
    }

    const byCategory = {};
    for (const [ingredientId, total] of Object.entries(totals)) {
      const ing = ingredientsMap[ingredientId];
      if (!ing) continue;
      const dp  = ing.decimalPlaces;
      const qty = dp === 0 ? String(Math.round(total)) : total.toFixed(dp);
      const cat = ing.category;
      if (!byCategory[cat]) byCategory[cat] = [];
      let altDisplay = null;
      if (ing.alternativeUnit) {
        const { perUnit, symbol } = ing.alternativeUnit;
        const altVal     = total / perUnit;
        const altRounded = Math.round(altVal * 10) / 10;
        const altStr     = altRounded % 1 === 0 ? String(Math.round(altRounded)) : altRounded.toFixed(1);
        altDisplay = `≈ ${altStr} ${symbol}`;
      }
      byCategory[cat].push({ ingredientId, displayName: ing.displayName, quantity: qty, unit: ing.unitSymbol, altDisplay });
    }

    for (const items of Object.values(byCategory)) {
      items.sort((a, b) => a.displayName.localeCompare(b.displayName, 'pl'));
    }
    return byCategory;
  }

  /** Liczy sumę makr dla podanych recipeIds. */
  function computeMacros(recipeIds) {
    let cal = 0, prot = 0, fat = 0, carbs = 0;
    for (const rid of recipeIds) {
      const recipe = recipesMap[rid];
      if (!recipe) continue;
      for (const { ingredientId, quantity } of recipe.ingredients) {
        const ing = ingredientsMap[ingredientId];
        if (!ing) continue;
        const qty = parseFloat(quantity);
        cal   += qty * ing.nutritionPerUnit.calories;
        prot  += qty * ing.nutritionPerUnit.protein;
        fat   += qty * ing.nutritionPerUnit.fat;
        carbs += qty * ing.nutritionPerUnit.carbs;
      }
    }
    return {
      calories: Math.round(cal   * 10) / 10,
      protein:  Math.round(prot  * 10) / 10,
      fat:      Math.round(fat   * 10) / 10,
      carbs:    Math.round(carbs * 10) / 10,
    };
  }

  window.shoppingListPage = function shoppingListPage() {
    return {
      allDays:  [],   // MealPlanDay[] — wszystkie zaplanowane dni
      dateFrom: '',
      dateTo:   '',
      list:     {},   // { [category]: ShoppingItem[] }
      macros:   null,
      checked:  {},   // { [ingredientId]: boolean }
      openCats: {},

      get isEmpty() {
        const ids = this._recipeIdsInRange();
        return ids.length === 0;
      },

      get rangeLabel() {
        if (!this.dateFrom || !this.dateTo) return '';
        const days = this._daysInRange();
        const withRecipes = days.filter((d) =>
          (d.slots ?? []).some((s) => s.recipeId)
        ).length;
        if (withRecipes === 0) return 'Brak przepisów w wybranym zakresie.';
        const label = withRecipes === 1 ? '1 dzień' : `${withRecipes} dni`;
        return `${label} z przepisami`;
      },

      get categories() {
        return CATEGORY_ORDER.filter((cat) => this.list[cat]?.length > 0);
      },

      categoryLabel(cat) { return categoryLabels[cat] ?? cat; },

      toggle(ingredientId) {
        this.checked[ingredientId] = !this.checked[ingredientId];
      },

      _daysInRange() {
        if (!this.dateFrom || !this.dateTo) return [];
        return this.allDays.filter(
          (d) => d.date >= this.dateFrom && d.date <= this.dateTo
        );
      },

      _recipeIdsInRange() {
        return this._daysInRange().flatMap((d) =>
          (d.slots ?? []).map((s) => s.recipeId).filter(Boolean)
        );
      },

      _rebuild() {
        const ids = this._recipeIdsInRange();
        if (ids.length === 0) {
          this.list   = {};
          this.macros = null;
          return;
        }
        this.list   = buildList(ids);
        this.macros = computeMacros(ids);
        this.checked = {};
        for (const cat of CATEGORY_ORDER) this.openCats[cat] = true;
      },

      init() {
        this.allDays = loadDays();

        // Domyślny zakres dat: cały zakres zaplanowanych dni, albo dziś ± 6
        if (this.allDays.length > 0) {
          const sorted = [...this.allDays].sort((a, b) => a.date.localeCompare(b.date));
          this.dateFrom = sorted[0].date;
          this.dateTo   = sorted[sorted.length - 1].date;
        } else {
          this.dateFrom = todayISO();
          this.dateTo   = addDaysISO(todayISO(), 6);
        }

        this._rebuild();
      },
    };
  };
</script>
