---
import { getCollection, render } from 'astro:content';
import Decimal from 'decimal.js';
import Base from '../../layouts/Base.astro';
import { getIngredients } from '../../lib/domain/getIngredients.js';
import { calculateRecipeMacros } from '../../lib/domain/macros.js';
import { formatQuantity } from '../../lib/format.js';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const { title, servings, prepTimeMinutes, tags, ingredients: recipeIngredients, image } = entry.data;

const allIngredients = getIngredients();
const ingredientMap = new Map(allIngredients.map((i) => [i.id, i]));

/** Pomocnik: formatuje wartość alternatywnej jednostki (np. "≈ 3 szklanki") */
function fmtAlt(quantity: string, perUnit: number, symbol: string): string {
  const val = new Decimal(quantity).dividedBy(perUnit);
  const str = val.isInteger() ? val.toFixed(0) : val.toDecimalPlaces(1).toFixed(1);
  return `≈ ${str} ${symbol}`;
}

const ingredientList = recipeIngredients.map((item) => {
  const ingredient = ingredientMap.get(item.ingredientId);
  if (!ingredient) return null;
  const formatted = formatQuantity(
    new Decimal(item.quantity),
    ingredient.formatting.decimalPlaces,
    ingredient.unit.symbol
  );
  const altDisplay = ingredient.alternativeUnit
    ? fmtAlt(item.quantity, ingredient.alternativeUnit.perUnit, ingredient.alternativeUnit.symbol)
    : null;
  return { ingredient, formatted, altDisplay };
}).filter((x): x is NonNullable<typeof x> => x !== null);

const macros = calculateRecipeMacros(
  {
    id: entry.id,
    title,
    servings,
    prepTimeMinutes,
    tags,
    ingredients: recipeIngredients,
  },
  allIngredients
);

const servingsLabel =
  servings === 1 ? '1 porcja' : servings < 5 ? `${servings} porcje` : `${servings} porcji`;

const base = import.meta.env.BASE_URL;
---

<Base title={title}>
  <!-- Breadcrumb -->
  <nav class="mb-6 text-sm text-gray-500" aria-label="Nawigacja okruszkowa">
    <a href={base} class="inline-flex min-h-[44px] items-center hover:text-green-700">Przepisy</a>
    <span class="mx-2">›</span>
    <span class="text-gray-700">{title}</span>
  </nav>

  <!-- Nagłówek -->
  <div class="mb-8">
    <h1 class="mb-2 text-3xl font-bold text-gray-900">{title}</h1>
    <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
      <span>⏱ {prepTimeMinutes} min</span>
      <span>🍽 {servingsLabel}</span>
    </div>
    <div class="mt-3 flex flex-wrap gap-1">
      {tags.map((tag) => (
        <span class="rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700">
          {tag}
        </span>
      ))}
    </div>
  </div>

  {image && (
    <div class="mb-8 overflow-hidden rounded-2xl">
      <img
        src={`${base}${image}`}
        alt={title}
        class="h-64 w-full object-cover sm:h-80 lg:h-96"
        loading="lazy"
      />
    </div>
  )}

  <div class="lg:grid lg:grid-cols-3 lg:gap-8">
    <!-- Sidebar: składniki + makra -->
    <aside class="mb-8 space-y-4 lg:col-span-1 lg:mb-0">
      <!-- Składniki -->
      <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
        <h2 class="mb-3 text-base font-semibold text-gray-900">Składniki</h2>
        <ul class="space-y-2">
          {ingredientList.map(({ ingredient, formatted, altDisplay }) => (
            <li class="flex items-baseline justify-between gap-2 text-sm">
              <span class="text-gray-700">{ingredient.displayName}</span>
              {altDisplay ? (
                <span
                  class="relative shrink-0 cursor-help"
                  x-data="{ tip: false, _t: null }"
                  @mouseenter="tip = true"
                  @mouseleave="tip = false"
                  @touchstart.passive="_t = setTimeout(() => tip = true, 500)"
                  @touchend.passive="clearTimeout(_t)"
                  @touchmove.passive="clearTimeout(_t)"
                >
                  <span class="font-medium text-gray-900 underline decoration-dotted decoration-gray-400">
                    {formatted}
                  </span>
                  <span
                    x-show="tip"
                    x-transition
                    class="pointer-events-none absolute right-0 bottom-full z-10 mb-1 rounded bg-gray-800 px-2 py-0.5 text-xs whitespace-nowrap text-white"
                  >{altDisplay}</span>
                </span>
              ) : (
                <span class="shrink-0 font-medium text-gray-900">{formatted}</span>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- Makra -->
      <div class="rounded-xl border border-green-100 bg-green-50 p-4">
        <h2 class="mb-3 text-base font-semibold text-gray-900">Wartości odżywcze</h2>
        <div class="grid grid-cols-2 gap-3">
          <div class="rounded-lg bg-white p-2 text-center shadow-sm">
            <p class="text-xl font-bold text-green-700">{macros.calories}</p>
            <p class="text-xs text-gray-500">kcal</p>
          </div>
          <div class="rounded-lg bg-white p-2 text-center shadow-sm">
            <p class="text-xl font-bold text-green-700">{macros.protein} g</p>
            <p class="text-xs text-gray-500">białko</p>
          </div>
          <div class="rounded-lg bg-white p-2 text-center shadow-sm">
            <p class="text-xl font-bold text-green-700">{macros.fat} g</p>
            <p class="text-xs text-gray-500">tłuszcze</p>
          </div>
          <div class="rounded-lg bg-white p-2 text-center shadow-sm">
            <p class="text-xl font-bold text-green-700">{macros.carbs} g</p>
            <p class="text-xs text-gray-500">węglowodany</p>
          </div>
        </div>
      </div>
    </aside>

    <!-- Treść: kroki przygotowania -->
    <article class="lg:col-span-2">
      <h2 class="mb-4 text-xl font-semibold text-gray-900">Przygotowanie</h2>
      <div class="recipe-content space-y-4 text-gray-700">
        <Content />
      </div>
    </article>
  </div>
</Base>

<style>
  .recipe-content :global(h2) {
    @apply mt-6 mb-2 text-base font-semibold text-gray-800;
  }
  .recipe-content :global(p) {
    @apply leading-relaxed;
  }
  .recipe-content :global(ul),
  .recipe-content :global(ol) {
    @apply ml-4 space-y-1 list-disc;
  }
</style>
