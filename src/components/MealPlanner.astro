---
interface RecipeOption {
  id: string;
  title: string;
  prepTimeMinutes: number;
}

interface Props {
  recipes: RecipeOption[];
}
const { recipes } = Astro.props;
---

<!-- Siatka dni: 1 kolumna mobile → 2 na md → 3 na lg -->
<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
  <template x-for="(day, dayIndex) in days" :key="day.date">
    <div class="flex flex-col rounded-xl border border-gray-200 bg-white p-4 shadow-sm">

      <!-- Nagłówek dnia -->
      <div class="mb-3 flex items-center justify-between gap-2">
        <span class="font-semibold text-gray-900">
          Dzień <span x-text="dayIndex + 1"></span>
        </span>
        <span class="text-sm text-gray-500 capitalize" x-text="formatDate(day.date)"></span>
      </div>

      <!-- Wybór przepisów: przyciski-pill -->
      <div class="flex flex-wrap gap-2">
        {recipes.map((recipe) => (
          <button
            type="button"
            x-on:click={`toggleRecipe(dayIndex, '${recipe.id}')`}
            x-bind:class={`hasRecipe(dayIndex, '${recipe.id}')
              ? 'bg-green-600 text-white border-green-600'
              : 'bg-white text-gray-600 border-gray-300 hover:border-green-400'`}
            class="rounded-full border px-3 py-1.5 text-sm font-medium transition"
          >
            {recipe.title}
          </button>
        ))}
      </div>

      <!-- Info gdy brak wyboru -->
      <p
        x-show="day.recipeIds.length === 0"
        class="mt-3 text-xs text-gray-400"
      >
        Brak wybranych przepisów
      </p>

      <!-- Lista wybranych przepisów -->
      <ul x-show="day.recipeIds.length > 0" class="mt-3 space-y-1">
        <template x-for="rid in day.recipeIds" :key="rid">
          <li class="flex items-center gap-1.5 text-sm text-gray-700">
            <span class="text-green-600">✓</span>
            <span x-text="recipeTitle(rid)"></span>
          </li>
        </template>
      </ul>
    </div>
  </template>
</div>
