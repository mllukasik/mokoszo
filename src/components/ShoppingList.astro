---
// Brak props — dane z rodzica x-data="shoppingListPage()"
// categories, list, openCats, categoryLabel(), toggle(), checked
---

<section>
  <h2 class="mb-4 text-xl font-semibold text-gray-900">Co kupić</h2>

  <div class="space-y-3">
    <template x-for="cat in categories" :key="cat">
      <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

        <!-- Nagłówek kategorii — zwijany -->
        <button
          type="button"
          class="flex w-full items-center justify-between px-4 py-3 text-left font-semibold text-gray-800 hover:bg-gray-50"
          x-on:click="openCats[cat] = !openCats[cat]"
        >
          <span x-text="categoryLabel(cat)"></span>
          <span
            class="ml-2 text-gray-400 transition-transform duration-200"
            x-bind:class="openCats[cat] ? 'rotate-180' : ''"
          >▼</span>
        </button>

        <!-- Lista składników -->
        <div x-show="openCats[cat]">
          <ul class="divide-y divide-gray-100 px-4 pb-2">
            <template x-for="item in list[cat]" :key="item.ingredientId">
              <!--
                x-data na <li> — każdy wiersz ma własny stan tooltipa (tip/timer).
                Tooltip i ilość mają dostęp do `tip` przez dziedziczenie scope'u Alpine.
              -->
              <li
                class="flex min-h-[44px] items-center gap-3"
                x-data="{ tip: false, _t: null }"
              >
                <!-- Checkbox — min 44px touch target -->
                <span class="flex min-h-[44px] flex-shrink-0 items-center">
                  <input
                    type="checkbox"
                    class="h-6 w-6 cursor-pointer rounded border-gray-300 accent-green-600"
                    x-bind:id="'chk-' + item.ingredientId"
                    x-bind:checked="!!checked[item.ingredientId]"
                    x-on:change="toggle(item.ingredientId)"
                  />
                </span>

                <!--
                  Label z `relative` — tooltip (position: absolute) będzie
                  pozycjonowany względem tej etykiety.
                  Struktura dzieci:
                    1. span[nazwa]   ← first-child (test: span:first-child)
                    2. span[ilość]   ← second-child
                    3. span[tooltip] ← third-child, absolutny, ukryty domyślnie
                -->
                <label
                  class="relative flex min-h-[44px] flex-1 cursor-pointer items-center justify-between gap-2 select-none"
                  x-bind:for="'chk-' + item.ingredientId"
                >
                  <!-- 1. Nazwa składnika -->
                  <span
                    class="text-base text-gray-900 transition-colors"
                    x-bind:class="checked[item.ingredientId] ? 'line-through text-gray-400' : ''"
                    x-text="item.displayName"
                  ></span>

                  <!-- 2. Ilość — z podpowiedzią kursora gdy jest altDisplay -->
                  <span
                    class="flex-shrink-0 text-base font-medium text-gray-600 transition-colors"
                    x-bind:class="[
                      checked[item.ingredientId] ? 'text-gray-300' : '',
                      item.altDisplay ? 'underline decoration-dotted decoration-gray-400 cursor-help' : ''
                    ]"
                    x-text="item.quantity + ' ' + item.unit"
                    @mouseenter="item.altDisplay && (tip = true)"
                    @mouseleave="tip = false"
                    @touchstart.passive="item.altDisplay && (_t = setTimeout(() => tip = true, 500))"
                    @touchend.passive="clearTimeout(_t)"
                    @touchmove.passive="clearTimeout(_t)"
                  ></span>

                  <!-- 3. Tooltip z alternatywną jednostką (absolute, nad ilością) -->
                  <span
                    x-show="tip"
                    x-transition
                    class="pointer-events-none absolute right-0 bottom-full z-10 mb-1 rounded bg-gray-800 px-2 py-0.5 text-xs whitespace-nowrap text-white"
                    x-text="item.altDisplay"
                  ></span>
                </label>
              </li>
            </template>
          </ul>
        </div>

      </div>
    </template>
  </div>
</section>
